<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions yet. INTERNET arrives with the gated client in M1-S2.
      allowBackup is off: Android's cloud backup would send feed URLs (which can carry
      private tokens) to Google. Our own backups to an owner-chosen folder come in M1-S4.
    -->
    <application
        android:name=".PodplayerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Podplayer">

        <!-- configChanges="uiMode": the theme switch recomposes in place instead of recreating. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
