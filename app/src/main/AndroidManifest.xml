<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Feeds and episodes (M1-S5). Every request goes through the gated client in :core:net. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to tell whether there is a network, for the screens' offline messages (M1-S8). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      The download progress notification. Downloads run without it too (as a dataSync foreground
      service, declared in :core:jobs); Android just doesn't show the notification in the shade.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      allowBackup is off: Android's cloud backup would send feed URLs (which can carry
      private tokens) to Google. Our own backups go to a folder the owner picks (M1-S4),
      through the Storage Access Framework, which needs no permission.
    -->
    <application
        android:name=".PodplayerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Podplayer">

        <!-- configChanges="uiMode": the theme switch recomposes in place instead of recreating. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- M1-S9a: a list of shows shared in as text opens Discover › Import a list (nothing subscribes until confirmed). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- WorkManager starts on demand with PodplayerApp's configuration (our worker factory). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          Settings › Logs › Export (M1-S9): shares the one redacted export file, and only it, with the app the
          owner picks in the share sheet. Not exported; that app gets a one-time read grant for the file.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logexport"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_export_paths" />
        </provider>

    </application>
</manifest>
