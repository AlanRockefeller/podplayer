<resources>
    <!--
      Window theme only; Compose draws everything else from the color tokens.
      Light here, dark in values-night. On Android 12+ the app's saved night mode picks
      between them (see MainActivity), so the starting window matches the saved theme.
    -->
    <style name="Theme.Podplayer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
