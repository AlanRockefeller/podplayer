<!--
  Android 10 and 11 (API 29-30). allowBackup is already off; this repeats that nothing may go
  to cloud backup, in case allowBackup is ever turned on. See data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
