<!--
  SPEC §3: http feeds and media are allowed (shown as "not secure"). Android refuses cleartext unless the app opts
  in here. Where requests may go is still decided by the address filter in :core:net. Only the system's
  certificates are trusted, never user-installed ones.
-->
<!-- InsecureBaseConfiguration: deliberate (SPEC §3, owner 2026-11-16); podcasts are often served over http. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
