package sample

import androidx.media3.common.MediaMetadata
import androidx.media3.common.util.BitmapLoader
import us.dikarya.podplayer.core.imagesandbox.coil.SandboxImageLoader
import us.dikarya.podplayer.playback.ArtworkBitmapLoader

fun loader(source: ArtworkBitmapLoader): BitmapLoader = source

fun name(loader: SandboxImageLoader) = loader.toString()

fun metadata(uri: android.net.Uri) = MediaMetadata.Builder().setArtworkUri(uri).build()
