package sample

import androidx.media3.exoplayer.MediaExtractorCompat
import androidx.media3.exoplayer.MetadataRetriever

// Media3's JVM extractors are the approved way to probe untrusted files.
fun probe(context: android.content.Context) = MediaExtractorCompat(context) to MetadataRetriever::class
