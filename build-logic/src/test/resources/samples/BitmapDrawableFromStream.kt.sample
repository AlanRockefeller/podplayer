package sample

import android.content.res.Resources
import android.graphics.drawable.BitmapDrawable
import java.io.InputStream

// BitmapDrawable's stream and path constructors decode in the calling process.
fun drawable(resources: Resources, stream: InputStream) = BitmapDrawable(resources, stream)
