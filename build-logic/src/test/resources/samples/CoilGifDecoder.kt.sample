package sample

import coil3.ImageLoader
import coil3.gif.AnimatedImageDecoder

// coil-gif decodes animations in the app process; the sandbox is the only decoder of untrusted images.
fun withGifs(loader: ImageLoader) = loader.components.newBuilder().add(AnimatedImageDecoder.Factory()).build()
