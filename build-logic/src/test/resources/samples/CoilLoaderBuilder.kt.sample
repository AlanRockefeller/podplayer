package sample

import android.content.Context
import coil3.ImageLoader

// A second Coil loader would have every default fetcher and none of the sandbox guards.
fun loader(context: Context) = ImageLoader.Builder(context).build()

fun defaultLoader(context: Context) = ImageLoader(context)
