package us.dikarya.podplayer.ui

import androidx.compose.runtime.Composable
import us.dikarya.podplayer.R
import us.dikarya.podplayer.dev.DeveloperScreen

// Main code reaching into the debug-only Developer screen: a release build must never be able to.
@Composable
fun Shortcut() {
    DeveloperScreen()
    println(R.string.dev_title)
}
