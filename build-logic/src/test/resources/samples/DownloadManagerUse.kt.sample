package sample

import android.app.DownloadManager
import android.content.Context
import android.net.Uri

// The system downloader fetches outside the gated client: no address filter, no limits, no redaction.
fun fetch(context: Context, url: String) =
    context.getSystemService(DownloadManager::class.java).enqueue(DownloadManager.Request(Uri.parse(url)))
