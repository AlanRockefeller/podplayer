package sample

import androidx.media3.datasource.FileDataSource
import androidx.media3.datasource.okhttp.OkHttpDataSource
import androidx.media3.exoplayer.source.ProgressiveMediaSource
import okhttp3.Call

// The gated way: OkHttpDataSource on the call factory the gate in :core:net hands out.
fun gated(calls: Call.Factory) = ProgressiveMediaSource.Factory(OkHttpDataSource.Factory(calls))

fun local() = ProgressiveMediaSource.Factory(FileDataSource.Factory())
