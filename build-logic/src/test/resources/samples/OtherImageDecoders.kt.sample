package sample

import android.graphics.Movie
import android.media.ExifInterface
import android.widget.ImageView
import java.io.InputStream

// Three more ways to decode untrusted image bytes in the app process.
fun animation(stream: InputStream) = Movie.decodeStream(stream)

fun orientation(path: String) = ExifInterface(path).getAttribute(ExifInterface.TAG_ORIENTATION)

fun show(view: ImageView, uri: android.net.Uri) = view.setImageURI(uri)
