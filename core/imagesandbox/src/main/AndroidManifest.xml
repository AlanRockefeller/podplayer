<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          The image decoder (SPEC §6). isolatedProcess: a separate, throwaway user id with no permissions, no
          network and no access to the app's files. Not exported: only this app can bind to it.
        -->
        <service
            android:name=".sandbox.ImageSandboxService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":imagesandbox" />

        <!--
          Artwork for Media3 and Android Auto: content URIs of sandbox-produced cache files, read-only.
          Not exported; Android Auto (M1-S10) gets a per-URI read grant.
        -->
        <provider
            android:name=".provider.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
