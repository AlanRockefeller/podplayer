<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Playback runs as a foreground service of type mediaPlayback (SPEC §10). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Keeps the CPU (files) or CPU and Wi-Fi (streams) awake while playing: the player's wake mode. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <!--
          Exported without a permission so the lock screen, Bluetooth, cars and (from S10) Android Auto can
          control playback; a permission would lock them out. Every other app's request is treated as hostile in
          code instead: SessionCallback (custom commands for our screens only, items resolved by id, URIs ignored)
          and PodPlayer (the Bluetooth play gate).
        -->
        <service
            android:name="us.dikarya.podplayer.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          Playback resumption (SPEC §10): headset, lock-screen and system media buttons reach the service even
          after it or the process was killed. A Play right after Bluetooth connects is still ignored, before the
          service is started for it (GatedMediaButtonReceiver; once running, PodPlayer).
        -->
        <receiver
            android:name="us.dikarya.podplayer.playback.GatedMediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
